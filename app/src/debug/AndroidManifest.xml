<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- V00b: debug builds only. The UI screenshot flows seed History/Progress with `adb shell am broadcast`.
             Protected by the DUMP permission, which the adb shell holds and ordinary apps cannot get. -->
        <receiver
            android:name=".debug.SeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.calisthenics.personal.debug.SEED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
