<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".CalisthenicsMemoryApplication"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalisthenicsMemory">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
            android:theme="@style/Theme.CalisthenicsMemory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WorkoutTimerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Calisthenics workout session timer: keeps the countdown, audio cues and visible progress notification alive while the app is backgrounded during an active workout (A02, docs/05-architecture.md)." />
        </service>

        <!-- T04 runtime-feasibility spike (disposable probe, not production content).
             Keeps a service-owned timer alive with a foreground notification so G1 can
             measure whether the foreground-service path survives a locked S21.
             exported="true" so the S21 session can start it directly via adb
             (`am start-foreground-service`) without depending on the androidTest
             APK (whose KSP build needs sqlite-jdbc natives unavailable in the
             sandbox). Disposable: the spike is deleted before T15, taking this
             export with it. -->
        <service
            android:name=".spike.SpikeSessionService"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="T04 runtime-feasibility spike (disposable probe for G1): service-owned timer with foreground notification to test background/lock survival." />
        </service>
    </application>

</manifest>